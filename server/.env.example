# HyperGravity — copy to ../.env and fill in.

# a1mobile (from your kickoff card)
A1_TEAM_KEY=
A1_BASE=https://hack.a1mobile.com
A1_MCP=https://hack.a1mobile.com/mcp/
A1_PHONE_NUMBER=

# Model gateway. An OpenAI *Responses* endpoint, not chat/completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=openai.gpt-5.6-sol

# Cartesia — one key covers both STT and TTS
CARTESIA_API_KEY=
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_VOICE_ID=

# Your handset. Receives SMS, and is trusted for Mac access.
MY_PHONE=
# Extra trusted numbers, comma separated.
TRUSTED_NUMBERS=

# Let ANY caller drive the Mac. Off by default, which is the right posture for
# something reachable from a public number — strangers still get the full
# booking and verification demo. Turn on for a supervised demo.
OPEN_ACCESS=

# Seconds of silence before checking the caller is still there.
IDLE_SECONDS=9
